#!/bin/sh
# ブランチ切り替え時にapm.ymlが差分にある場合にapm installを実行する
PREV_HEAD=$1
NEW_HEAD=$2
BRANCH_SWITCH=$3

# ブランチ切り替え (BRANCH_SWITCH=1) のみ対象
if [ "$BRANCH_SWITCH" = "1" ]; then
  if git diff --name-only "$PREV_HEAD" "$NEW_HEAD" 2>/dev/null | grep -qE '^(apm\.yml|apm\.lock\.yaml)$'; then
    echo "[apm] apm.yml changed, running apm install..."
    apm install
  fi
fi
